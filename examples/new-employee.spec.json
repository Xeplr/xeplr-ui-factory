{
  "name": "New employee",
  "source": "employees",
  "fields": [
    { "label": "First name", "required": true, "validation": { "maxLength": 80 } },
    { "label": "Last name", "required": true, "validation": { "maxLength": 80 } },
    { "label": "Work email", "required": true, "validation": { "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "patternMessage": "Enter a valid email address" } },
    { "label": "Phone", "validation": { "pattern": "^[0-9+ ()-]{7,20}$", "patternMessage": "Enter a valid phone number" } },
    { "type": "label", "text": "Employment", "variant": "subheading" },
    { "label": "Department", "type": "dropdown", "table": "departments", "required": true },
    { "label": "Employment type", "type": "dropdown", "options": ["Full time", "Part time", "Contract"], "required": true },
    { "label": "Start date", "type": "date", "required": true },
    { "label": "Annual salary", "type": "number", "validation": { "min": 0 } },
    { "label": "Remote", "type": "checkbox" },
    { "label": "Notes", "type": "textarea", "validation": { "maxLength": 1000 } }
  ],
  "list": {
    "title": "Employees",
    "columns": [
      { "field": "firstName", "label": "First name" },
      { "field": "lastName", "label": "Last name" },
      { "field": "workEmail", "label": "Email" },
      { "field": "department", "label": "Department" },
      { "field": "startDate", "label": "Start date" }
    ]
  }
}
